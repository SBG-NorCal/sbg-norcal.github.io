# EditorConfig — keeps file formatting consistent across editors and OSes.
# Helps cross-platform contributors avoid line-ending and indentation diffs.
# Reference: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown preserves trailing spaces (two spaces = line break)
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{rb,ru}]
indent_size = 2
