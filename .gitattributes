# Git attributes — enforce LF line endings across all platforms so Windows
# checkouts don't introduce CRLF diffs into shared files.
# Reference: https://git-scm.com/docs/gitattributes

* text=auto eol=lf

# Binary files should never be normalized
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary
*.zip    binary
*.gz     binary
*.tar    binary
